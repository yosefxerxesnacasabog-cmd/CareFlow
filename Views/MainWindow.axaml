<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        xmlns:models="using:CareFlow.Models"
        xmlns:converters="using:Avalonia.Data.Converters"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CareFlow"
        Width="860" Height="700"
        MinWidth="650" MinHeight="570"
        x:CompileBindings="True">

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource CareFlowSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CareFlowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Grid.tableHeader">
            <Setter Property="Background" Value="{DynamicResource CareFlowTableHeaderBrush}" />
        </Style>
        <Style Selector="Grid.tableHeader > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CareFlowMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.tableRow">
            <Setter Property="BorderBrush" Value="{DynamicResource CareFlowBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource CareFlowMutedBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource CareFlowBackgroundBrush}">
        <Border Background="{StaticResource CareFlowHeaderBrush}">
            <StackPanel Margin="26,16,26,18" Spacing="3">
                <TextBlock Text="CareFlow" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Diagnostic Booking Management" Foreground="#D1EEEA" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="24,8,24,20">
            <TabItem Header="Book services" Padding="16,9">
                <Grid Margin="0,14,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Border Classes="panel" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Patient" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Patients}"
                                          SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                          PlaceholderText="Select a patient"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding CanSelectPatient}"
                                          AutomationProperties.Name="Patient">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Patient">
                                            <TextBlock Text="{Binding FullName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ProgressBar IsIndeterminate="True" Height="3"
                                             IsVisible="{Binding IsLoadingPatients}"
                                             AutomationProperties.Name="Loading patients" />
                                <TextBlock Text="{Binding PatientMessage}" Classes="caption" TextWrapping="Wrap"
                                           IsVisible="{Binding PatientMessage, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5" IsEnabled="{Binding !IsConfirming}">
                                <TextBlock Text="Booking date" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                            AutomationProperties.Name="Booking date" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="panel" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,10" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Diagnostic services" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Select one to three services." Classes="caption" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh slots" VerticalAlignment="Center"
                                        Command="{Binding RefreshAvailabilityCommand}" IsEnabled="{Binding !IsConfirming}" />
                            </Grid>

                            <Grid Grid.Row="1" Classes="tableHeader" ColumnDefinitions="*,105,115"
                                  ColumnSpacing="12" Height="32">
                                <TextBlock Margin="16,0,0,0" Text="Service" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Daily capacity" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Remaining slots" VerticalAlignment="Center" />
                            </Grid>

                            <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True"
                                         IsVisible="{Binding IsLoadingAvailability}"
                                         AutomationProperties.Name="Loading availability" />
                            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="{Binding AvailabilityMessage}" Margin="16,10"
                                               Classes="caption" TextWrapping="Wrap"
                                               IsVisible="{Binding AvailabilityMessage, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <ItemsControl ItemsSource="{Binding Availability}"
                                                  IsVisible="{Binding !IsLoadingAvailability}"
                                                  IsEnabled="{Binding !IsConfirming}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BookingServiceOption">
                                                <Border Classes="tableRow">
                                                    <Grid ColumnDefinitions="*,105,115" ColumnSpacing="12" MinHeight="40">
                                                        <CheckBox Margin="16,0,0,0" Content="{Binding Availability.Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Availability.DailyCapacity}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Padding="10,3" CornerRadius="6"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Background="{DynamicResource CareFlowSlotBackgroundBrush}">
                                                            <TextBlock Text="{Binding Availability.RemainingSlots}"
                                                                       Foreground="{DynamicResource CareFlowSlotForegroundBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="panel" Padding="16,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar Height="3" IsIndeterminate="True"
                                             IsVisible="{Binding IsConfirming}"
                                             AutomationProperties.Name="Confirming booking" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="accent" Padding="16,8"
                                    Content="Confirm booking" Command="{Binding ConfirmBookingCommand}"
                                    IsEnabled="{Binding !IsLoadingAvailability}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Booking history" Padding="16,9">
                <Border Margin="0,14,0,0" Classes="panel" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Button Margin="16,12" Content="Refresh history"
                                Command="{Binding History.RefreshCommand}"
                                IsEnabled="{Binding !History.IsLoading}" />

                        <Grid Grid.Row="1" Classes="tableHeader" ColumnDefinitions="96,*,112,2*"
                              ColumnSpacing="12" Height="34">
                            <TextBlock Margin="16,0,0,0" Text="Booking #" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Patient" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Date" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Diagnostic services" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True"
                                     IsVisible="{Binding History.IsLoading}"
                                     AutomationProperties.Name="Loading booking history" />
                        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding History.Message}" Classes="caption" Margin="16,12"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                           IsVisible="{Binding History.Message, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
                                <ItemsControl ItemsSource="{Binding History.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookingHistoryEntry">
                                            <Border Classes="tableRow" Padding="0,11">
                                                <Grid ColumnDefinitions="96,*,112,2*" ColumnSpacing="12">
                                                    <TextBlock Margin="16,0,0,0" Text="{Binding BookingId}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PatientName}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Text="{Binding BookingDate, StringFormat='{}{0:d}'}" />
                                                    <TextBlock Grid.Column="3" Margin="0,0,16,0"
                                                               Text="{Binding ServiceNames}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
